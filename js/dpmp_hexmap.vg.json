{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Hexagonal tile map: share of each state's donated organs transplanted in another state, 2025. Source: ANZOD Registry Annual Report 2026, Appendix I Table A1.25.",
  "title": {
    "text": "Organs from small states travel",
    "subtitle": [
      "Share of each state's donated organs that were transplanted interstate, 2025"
    ],
    "anchor": "start",
    "font": "Inter, system-ui, sans-serif",
    "fontSize": 15,
    "fontWeight": 600,
    "color": "#1e2430",
    "subtitleFont": "Inter, system-ui, sans-serif",
    "subtitleFontSize": 12,
    "subtitleColor": "#5c6675",
    "offset": 12
  },
  "width": 430,
  "height": 410,
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, sans-serif",
    "axis": {
      "labelColor": "#5c6675",
      "titleColor": "#5c6675",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "domainColor": "#c9cfd8",
      "tickColor": "#c9cfd8",
      "gridColor": "#e6e2db",
      "gridDash": [
        3,
        3
      ]
    },
    "legend": {
      "labelColor": "#5c6675",
      "titleColor": "#5c6675",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500
    }
  },
  "data": {
    "values": [
      {
        "state": "NT",
        "q": 1,
        "r": 0
      },
      {
        "state": "QLD",
        "q": 2,
        "r": 0
      },
      {
        "state": "WA",
        "q": 0.5,
        "r": 1
      },
      {
        "state": "SA",
        "q": 1.5,
        "r": 1
      },
      {
        "state": "NSW",
        "q": 2.5,
        "r": 1
      },
      {
        "state": "VIC",
        "q": 2,
        "r": 2
      },
      {
        "state": "ACT",
        "q": 3,
        "r": 2
      },
      {
        "state": "TAS",
        "q": 1.5,
        "r": 3
      }
    ]
  },
  "transform": [
    {
      "lookup": "state",
      "from": {
        "data": {
          "url": "data/organs_leaving_state_2025.csv",
          "format": {
            "type": "csv",
            "parse": {
              "organs_transplanted": "number",
              "transplanted_in_state": "number",
              "sent_interstate": "number",
              "pct_interstate": "number"
            }
          }
        },
        "key": "state",
        "fields": [
          "state_name",
          "organs_transplanted",
          "transplanted_in_state",
          "sent_interstate",
          "pct_interstate"
        ]
      }
    },
    {
      "calculate": "format(datum.pct_interstate, '.0f') + '%'",
      "as": "pct_label"
    }
  ],
  "encoding": {
    "x": {
      "field": "q",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          -0.4,
          3.5
        ],
        "nice": false,
        "zero": false
      }
    },
    "y": {
      "field": "r",
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          -0.65,
          3.65
        ],
        "nice": false,
        "zero": false,
        "reverse": true
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "point",
        "shape": "M0,-1 L0.866,-0.5 L0.866,0.5 L0,1 L-0.866,0.5 L-0.866,-0.5 Z",
        "filled": true,
        "size": 13000,
        "stroke": "#ffffff",
        "strokeWidth": 2,
        "opacity": 1
      },
      "encoding": {
        "color": {
          "field": "pct_interstate",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ],
            "range": [
              "#f6e3e2",
              "#8e1f37"
            ]
          },
          "legend": {
            "title": "% sent interstate",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 180,
            "values": [
              0,
              25,
              50,
              75,
              100
            ]
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "Donor state"
          },
          {
            "field": "organs_transplanted",
            "type": "quantitative",
            "title": "Organs transplanted"
          },
          {
            "field": "transplanted_in_state",
            "type": "quantitative",
            "title": "Transplanted in home state"
          },
          {
            "field": "sent_interstate",
            "type": "quantitative",
            "title": "Transplanted interstate"
          },
          {
            "field": "pct_interstate",
            "type": "quantitative",
            "title": "% interstate",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": 700,
        "dy": -9
      },
      "encoding": {
        "text": {
          "field": "state"
        },
        "color": {
          "condition": {
            "test": "datum.pct_interstate > 50",
            "value": "#ffffff"
          },
          "value": "#1e2430"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "dy": 9
      },
      "encoding": {
        "text": {
          "field": "pct_label"
        },
        "color": {
          "condition": {
            "test": "datum.pct_interstate > 50",
            "value": "#ffffff"
          },
          "value": "#1e2430"
        }
      }
    }
  ]
}
