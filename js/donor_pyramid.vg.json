{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Population pyramid of deceased organ donors by age group and sex, Australia, 2021-2025 combined. Source: ANZOD Registry Annual Report 2026, Appendix I Table A1.2.",
  "title": {
    "text": "Donors are mostly middle-aged, and more often men",
    "subtitle": [
      "Deceased organ donors by age and sex, Australia,",
      "2021–2025 combined (2,472 donors)"
    ],
    "anchor": "start"
  },
  "background": null,
  "data": {
    "url": "data/donor_age_sex.csv",
    "format": {
      "type": "csv",
      "parse": {
        "age_order": "number",
        "donors": "number"
      }
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, sans-serif",
    "title": {
      "anchor": "start",
      "font": "Inter, system-ui, sans-serif",
      "fontSize": 17,
      "fontWeight": 600,
      "color": "#1e2430",
      "subtitleFont": "Inter, system-ui, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#545e6c",
      "offset": 12,
      "subtitlePadding": 4
    },
    "axis": {
      "labelFont": "Inter, system-ui, sans-serif",
      "titleFont": "Inter, system-ui, sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 400,
      "labelColor": "#545e6c",
      "titleColor": "#545e6c",
      "domainColor": "#c9cfd8",
      "tickColor": "#c9cfd8",
      "gridColor": "#e6e2db",
      "gridDash": [
        3,
        3
      ]
    },
    "legend": {
      "labelFont": "Inter, system-ui, sans-serif",
      "titleFont": "Inter, system-ui, sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 400,
      "labelColor": "#545e6c",
      "titleColor": "#545e6c"
    },
    "text": {
      "font": "Inter, system-ui, sans-serif",
      "fontSize": 11
    }
  },
  "spacing": 0,
  "hconcat": [
    {
      "title": {
        "text": "Females",
        "anchor": "end",
        "fontSize": 13,
        "subtitleFontSize": 11
      },
      "transform": [
        {
          "filter": "datum.sex === 'Female'"
        }
      ],
      "width": 228,
      "height": 250,
      "layer": [
        {
          "mark": {
            "type": "bar",
            "cornerRadiusEnd": 2,
            "height": {
              "band": 0.8
            }
          },
          "encoding": {
            "y": {
              "field": "age_group",
              "type": "ordinal",
              "sort": {
                "field": "age_order",
                "order": "descending"
              },
              "axis": null
            },
            "x": {
              "field": "donors",
              "type": "quantitative",
              "title": "Donors, 2021–2025",
              "scale": {
                "domain": [
                  0,
                  340
                ],
                "reverse": true
              },
              "axis": {
                "tickCount": 4,
                "grid": true
              }
            },
            "color": {
              "field": "sex",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Female",
                  "Male"
                ],
                "range": [
                  "#b0707d",
                  "#4f6d8a"
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "sex",
                "title": "Sex"
              },
              {
                "field": "age_group",
                "title": "Age"
              },
              {
                "field": "donors",
                "type": "quantitative",
                "title": "Donors"
              }
            ]
          },
          "description": "Female bars (one per age group)."
        },
        {
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -4,
            "fontSize": 11,
            "color": "#5c6675",
            "font": "Inter, system-ui, sans-serif"
          },
          "encoding": {
            "y": {
              "field": "age_group",
              "type": "ordinal",
              "sort": {
                "field": "age_order",
                "order": "descending"
              }
            },
            "x": {
              "field": "donors",
              "type": "quantitative"
            },
            "text": {
              "field": "donors",
              "type": "quantitative"
            }
          },
          "description": "Donor count at the end of each female bar."
        },
        {
          "data": {
            "values": [
              {
                "t": [
                  "Women are 2 in 5 donors",
                  "(1,011 of 2,472)"
                ]
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "right",
            "fontSize": 11,
            "fontStyle": "italic",
            "color": "#1e2430",
            "lineHeight": 13,
            "x": 125,
            "y": 222,
            "font": "Inter, system-ui, sans-serif"
          },
          "encoding": {
            "text": {
              "field": "t"
            }
          },
          "description": "Annotation: share of donors who are women."
        }
      ],
      "description": "Left half: female donors by age group. The x scale is reversed so bars grow leftwards."
    },
    {
      "width": 50,
      "height": 250,
      "view": {
        "stroke": null
      },
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 600,
        "color": "#1e2430",
        "font": "Inter, system-ui, sans-serif"
      },
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "ordinal",
          "sort": {
            "field": "age_order",
            "order": "descending"
          },
          "axis": null
        },
        "text": {
          "field": "age_group"
        }
      },
      "transform": [
        {
          "filter": "datum.sex === 'Male'"
        }
      ],
      "description": "Centre column: age-group labels shared by both halves."
    },
    {
      "title": {
        "text": "Males",
        "anchor": "start",
        "fontSize": 13,
        "subtitleFontSize": 11
      },
      "transform": [
        {
          "filter": "datum.sex === 'Male'"
        }
      ],
      "width": 228,
      "height": 250,
      "layer": [
        {
          "mark": {
            "type": "bar",
            "cornerRadiusEnd": 2,
            "height": {
              "band": 0.8
            }
          },
          "encoding": {
            "y": {
              "field": "age_group",
              "type": "ordinal",
              "sort": {
                "field": "age_order",
                "order": "descending"
              },
              "axis": null
            },
            "x": {
              "field": "donors",
              "type": "quantitative",
              "title": "Donors, 2021–2025",
              "scale": {
                "domain": [
                  0,
                  340
                ],
                "reverse": false
              },
              "axis": {
                "tickCount": 4,
                "grid": true
              }
            },
            "color": {
              "field": "sex",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Female",
                  "Male"
                ],
                "range": [
                  "#b0707d",
                  "#4f6d8a"
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "sex",
                "title": "Sex"
              },
              {
                "field": "age_group",
                "title": "Age"
              },
              {
                "field": "donors",
                "type": "quantitative",
                "title": "Donors"
              }
            ]
          },
          "description": "Male bars (one per age group)."
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 4,
            "fontSize": 11,
            "color": "#5c6675",
            "font": "Inter, system-ui, sans-serif"
          },
          "encoding": {
            "y": {
              "field": "age_group",
              "type": "ordinal",
              "sort": {
                "field": "age_order",
                "order": "descending"
              }
            },
            "x": {
              "field": "donors",
              "type": "quantitative"
            },
            "text": {
              "field": "donors",
              "type": "quantitative"
            }
          },
          "description": "Donor count at the end of each male bar."
        },
        {
          "data": {
            "values": [
              {
                "t": [
                  "Men aged 55–64 are the",
                  "largest group: 319 donors"
                ]
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "fontSize": 11,
            "fontStyle": "italic",
            "color": "#1e2430",
            "lineHeight": 13,
            "x": 95,
            "y": 222,
            "font": "Inter, system-ui, sans-serif"
          },
          "encoding": {
            "text": {
              "field": "t"
            }
          },
          "description": "Annotation: the largest single group (men aged 55-64)."
        }
      ],
      "description": "Right half: male donors by age group."
    }
  ],
  "padding": 0
}
