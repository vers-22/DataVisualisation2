{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Slope graph of deceased donors per million population by state, 2018 vs 2025. Source: ANZOD Registry Annual Report 2026, Table 2.1.",
  "title": {
    "text": "Most states are still below their 2018 donation rate",
    "subtitle": [
      "Deceased organ donors per million people, 2018 (national peak) vs 2025"
    ],
    "anchor": "start"
  },
  "width": "container",
  "height": 420,
  "background": null,
  "data": {
    "url": "data/donors_by_state_year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "donors": "number",
        "dpmp": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.year === 2018 || datum.year === 2025"
    },
    {
      "pivot": "year",
      "value": "dpmp",
      "groupby": [
        "state",
        "state_name"
      ]
    },
    {
      "calculate": "datum['2025'] >= datum['2018'] ? 'Rose' : 'Fell'",
      "as": "direction"
    },
    {
      "fold": [
        "2018",
        "2025"
      ],
      "as": [
        "year",
        "dpmp"
      ]
    },
    {
      "calculate": "toNumber(datum.year)",
      "as": "year"
    },
    {
      "lookup": "state",
      "from": {
        "data": {
          "values": [
            {
              "state": "WA",
              "y2018": 15.3,
              "y2025": 21.0
            },
            {
              "state": "NT",
              "y2018": 16.5,
              "y2025": 19.0
            },
            {
              "state": "QLD",
              "y2018": 18.5,
              "y2025": 17.2
            },
            {
              "state": "NSW",
              "y2018": 19.7,
              "y2025": 20.0
            },
            {
              "state": "SA",
              "y2018": 20.9,
              "y2025": 18.1
            },
            {
              "state": "AUS",
              "y2018": 22.2,
              "y2025": 22.0
            },
            {
              "state": "TAS",
              "y2018": 26.1,
              "y2025": 43.4
            },
            {
              "state": "VIC",
              "y2018": 30.0,
              "y2025": 23.1
            },
            {
              "state": "ACT",
              "y2018": 32.0,
              "y2025": 16.2
            }
          ]
        },
        "key": "state",
        "fields": [
          "y2018",
          "y2025"
        ]
      }
    },
    {
      "calculate": "datum.year === 2018 ? datum.y2018 : datum.y2025",
      "as": "label_y"
    },
    {
      "calculate": "(datum.state === 'AUS' ? 'Australia' : datum.state) + '  ' + format(datum.dpmp, '.1f')",
      "as": "label_right"
    },
    {
      "calculate": "format(datum.dpmp, '.1f') + '  ' + (datum.state === 'AUS' ? 'Australia' : datum.state)",
      "as": "label_left"
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, sans-serif",
    "title": {
      "anchor": "start",
      "font": "Inter, system-ui, sans-serif",
      "fontSize": 17,
      "fontWeight": 600,
      "color": "#1e2430",
      "subtitleFont": "Inter, system-ui, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#545e6c",
      "offset": 12,
      "subtitlePadding": 4
    },
    "axis": {
      "labelFont": "Inter, system-ui, sans-serif",
      "titleFont": "Inter, system-ui, sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 400,
      "labelColor": "#545e6c",
      "titleColor": "#545e6c",
      "domainColor": "#c9cfd8",
      "tickColor": "#c9cfd8",
      "gridColor": "#e6e2db",
      "gridDash": [
        3,
        3
      ]
    },
    "legend": {
      "labelFont": "Inter, system-ui, sans-serif",
      "titleFont": "Inter, system-ui, sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 400,
      "labelColor": "#545e6c",
      "titleColor": "#545e6c"
    },
    "text": {
      "font": "Inter, system-ui, sans-serif",
      "fontSize": 11
    }
  },
  "layer": [
    {
      "data": {
        "values": [
          {
            "y": 25
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          3
        ],
        "color": "#5c6675"
      },
      "encoding": {
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              14,
              45
            ]
          },
          "axis": null,
          "title": null
        }
      },
      "description": "Dashed horizontal rule at the national target (25 per million)."
    },
    {
      "data": {
        "values": [
          {
            "y": 25,
            "t": "National target: 25"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dy": -7,
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#5c6675",
        "x": "width",
        "font": "Inter, system-ui, sans-serif"
      },
      "encoding": {
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              14,
              45
            ]
          },
          "axis": null,
          "title": null
        },
        "text": {
          "field": "t"
        }
      },
      "description": "Label for the target rule."
    },
    {
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 40
        }
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "scale": {
            "padding": 0.6
          },
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 13,
            "labelFontWeight": 600,
            "labelColor": "#1e2430",
            "domain": false,
            "ticks": false,
            "orient": "top"
          }
        },
        "y": {
          "field": "dpmp",
          "type": "quantitative",
          "scale": {
            "domain": [
              14,
              45
            ]
          },
          "axis": null,
          "title": null
        },
        "detail": {
          "field": "state"
        },
        "color": {
          "condition": [
            {
              "test": "datum.state === 'AUS'",
              "value": "#1e2430"
            }
          ],
          "field": "direction",
          "type": "nominal",
          "scale": {
            "domain": [
              "Fell",
              "Rose"
            ],
            "range": [
              "#c8465e",
              "#466ec8"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "stroke",
            "labelExpr": "datum.label === 'Fell' ? 'Fell since 2018' : 'Rose since 2018'"
          }
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.state === 'AUS'",
            "value": 3.5
          },
          "value": 1.8
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "dpmp",
            "type": "quantitative",
            "title": "Donors per million",
            "format": ".1f"
          }
        ]
      },
      "description": "One line per state from 2018 to 2025. Red = fell, blue = rose, black = Australia."
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2025"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 11,
        "font": "Inter, system-ui, sans-serif"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "scale": {
            "padding": 0.6
          },
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 13,
            "labelFontWeight": 600,
            "labelColor": "#1e2430",
            "domain": false,
            "ticks": false,
            "orient": "top"
          }
        },
        "y": {
          "field": "label_y",
          "type": "quantitative",
          "scale": {
            "domain": [
              14,
              45
            ]
          },
          "axis": null,
          "title": null
        },
        "text": {
          "field": "label_right"
        },
        "color": {
          "condition": [
            {
              "test": "datum.state === 'AUS'",
              "value": "#1e2430"
            }
          ],
          "field": "direction",
          "type": "nominal",
          "scale": {
            "domain": [
              "Fell",
              "Rose"
            ],
            "range": [
              "#c8465e",
              "#466ec8"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "stroke",
            "labelExpr": "datum.label === 'Fell' ? 'Fell since 2018' : 'Rose since 2018'"
          }
        }
      },
      "description": "Labels at the 2025 end (state + value). Positions are nudged apart where values collide."
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2018"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "fontSize": 11,
        "font": "Inter, system-ui, sans-serif"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "scale": {
            "padding": 0.6
          },
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 13,
            "labelFontWeight": 600,
            "labelColor": "#1e2430",
            "domain": false,
            "ticks": false,
            "orient": "top"
          }
        },
        "y": {
          "field": "label_y",
          "type": "quantitative",
          "scale": {
            "domain": [
              14,
              45
            ]
          },
          "axis": null,
          "title": null
        },
        "text": {
          "field": "label_left"
        },
        "color": {
          "condition": [
            {
              "test": "datum.state === 'AUS'",
              "value": "#1e2430"
            }
          ],
          "field": "direction",
          "type": "nominal",
          "scale": {
            "domain": [
              "Fell",
              "Rose"
            ],
            "range": [
              "#c8465e",
              "#466ec8"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "stroke",
            "labelExpr": "datum.label === 'Fell' ? 'Fell since 2018' : 'Rose since 2018'"
          }
        }
      },
      "description": "Labels at the 2018 end (value + state)."
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "padding": 0
}
