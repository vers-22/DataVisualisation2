{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map of deceased organ donors by the city or town of the donor hospital, 2021-2025. Hospitals with 5 or more donors are grouped into 34 cities and towns (outer suburbs are part of their capital). Sources: ANZOD Registry Annual Report 2026 Appendix I Table A1.3; ABS state boundaries. Hospital locations geocoded by the author.",
  "title": {
    "text": "Three in four donors come from capital-city hospitals",
    "subtitle": [
      "Deceased organ donors by city of the donor hospital, 2021–2025.",
      "Circle area = donors. Hover a circle to see its hospitals"
    ],
    "anchor": "start"
  },
  "width": "container",
  "height": 500,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "padding": 0,
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, sans-serif",
    "title": {
      "anchor": "start",
      "font": "Inter, system-ui, sans-serif",
      "fontSize": 17,
      "fontWeight": 600,
      "color": "#1e2430",
      "subtitleFont": "Inter, system-ui, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#545e6c",
      "offset": 12,
      "subtitlePadding": 4
    },
    "axis": {
      "labelFont": "Inter, system-ui, sans-serif",
      "titleFont": "Inter, system-ui, sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 400,
      "labelColor": "#545e6c",
      "titleColor": "#545e6c",
      "domainColor": "#c9cfd8",
      "tickColor": "#c9cfd8",
      "gridColor": "#e6e2db",
      "gridDash": [
        3,
        3
      ]
    },
    "legend": {
      "labelFont": "Inter, system-ui, sans-serif",
      "titleFont": "Inter, system-ui, sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 400,
      "labelColor": "#545e6c",
      "titleColor": "#545e6c"
    },
    "text": {
      "font": "Inter, system-ui, sans-serif",
      "fontSize": 11
    }
  },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -132,
      0
    ],
    "parallels": [
      -18,
      -36
    ],
    "center": [
      0,
      -27
    ]
  },
  "layer": [
    {
      "description": "Grey base map of the states.",
      "data": {
        "url": "data/au_states.topojson.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2026_AUST_GDA2020"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.STE_CODE26 <= '8'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#ece7df",
        "stroke": "#ffffff",
        "strokeWidth": 1
      }
    },
    {
      "description": "One circle per city or town. Area is proportional to donors from 2021 to 2025; colour shows capital city (coral) or regional centre (grey). Small circles are drawn on top of large ones.",
      "data": {
        "url": "data/donor_cities.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number",
            "hospitals": "number",
            "donors_2021_2025": "number",
            "donors_2025": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "stroke": "#ffffff",
        "strokeWidth": 1,
        "opacity": 0.85
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "donors_2021_2025",
          "type": "quantitative",
          "scale": {
            "range": [
              25,
              2200
            ]
          },
          "legend": {
            "title": "Donors 2021–2025",
            "values": [
              25,
              100,
              250,
              500
            ],
            "orient": "bottom",
            "direction": "horizontal",
            "symbolFillColor": "#8fa3b8",
            "symbolStrokeColor": "#ffffff"
          }
        },
        "color": {
          "field": "city_type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Capital city",
              "Regional"
            ],
            "range": [
              "#c8465e",
              "#8fa3b8"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "circle"
          }
        },
        "order": {
          "field": "donors_2021_2025",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "city",
            "title": "City or town"
          },
          {
            "field": "hospitals",
            "type": "quantitative",
            "title": "Hospitals shown"
          },
          {
            "field": "donors_2021_2025",
            "type": "quantitative",
            "title": "Donors 2021–2025",
            "format": ","
          },
          {
            "field": "donors_2025",
            "type": "quantitative",
            "title": "Donors in 2025"
          },
          {
            "field": "top_hospitals",
            "title": "Busiest hospitals"
          }
        ]
      }
    },
    {
      "description": "Labels (city and donor total) for the largest places, placed to the right of the circle.",
      "data": {
        "url": "data/donor_cities.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number",
            "hospitals": "number",
            "donors_2021_2025": "number",
            "donors_2025": "number"
          }
        }
      },
      "transform": [
        {
          "lookup": "city",
          "from": {
            "data": {
              "values": [
                {
                  "city": "Sydney",
                  "lon": 153.0,
                  "lat": -34.7
                },
                {
                  "city": "Brisbane",
                  "lon": 154.4,
                  "lat": -25.9
                },
                {
                  "city": "Newcastle",
                  "lon": 153.4,
                  "lat": -31.2
                },
                {
                  "city": "Gold Coast",
                  "lon": 154.4,
                  "lat": -29.0
                },
                {
                  "city": "Hobart",
                  "lon": 148.6,
                  "lat": -43.0
                },
                {
                  "city": "Townsville",
                  "lon": 147.9,
                  "lat": -19.0
                },
                {
                  "city": "Darwin",
                  "lon": 132.0,
                  "lat": -12.4
                },
                {
                  "city": "Perth",
                  "lon": 117.6,
                  "lat": -32.0
                }
              ]
            },
            "key": "city",
            "fields": [
              "lon",
              "lat"
            ]
          },
          "as": [
            "lx",
            "ly"
          ]
        },
        {
          "filter": "isValid(datum.lx)"
        },
        {
          "calculate": "[datum.city, format(datum.donors_2021_2025, ',') + ' donors']",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "lineHeight": 13,
        "fontSize": 11,
        "font": "Inter, system-ui, sans-serif",
        "color": "#1e2430"
      },
      "encoding": {
        "longitude": {
          "field": "lx",
          "type": "quantitative"
        },
        "latitude": {
          "field": "ly",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "description": "Labels (city and donor total) for the largest places, placed to the left of the circle.",
      "data": {
        "url": "data/donor_cities.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number",
            "hospitals": "number",
            "donors_2021_2025": "number",
            "donors_2025": "number"
          }
        }
      },
      "transform": [
        {
          "lookup": "city",
          "from": {
            "data": {
              "values": [
                {
                  "city": "Melbourne",
                  "lon": 142.4,
                  "lat": -38.2
                },
                {
                  "city": "Adelaide",
                  "lon": 136.6,
                  "lat": -35.0
                },
                {
                  "city": "Canberra",
                  "lon": 146.6,
                  "lat": -33.4
                }
              ]
            },
            "key": "city",
            "fields": [
              "lon",
              "lat"
            ]
          },
          "as": [
            "lx",
            "ly"
          ]
        },
        {
          "filter": "isValid(datum.lx)"
        },
        {
          "calculate": "[datum.city, format(datum.donors_2021_2025, ',') + ' donors']",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "lineHeight": 13,
        "fontSize": 11,
        "font": "Inter, system-ui, sans-serif",
        "color": "#1e2430"
      },
      "encoding": {
        "longitude": {
          "field": "lx",
          "type": "quantitative"
        },
        "latitude": {
          "field": "ly",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}
