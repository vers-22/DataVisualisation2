{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Isotype chart: of every 10 families asked about donation, how many say yes when their loved one was or was not a registered donor. Source: Organ and Tissue Authority, 2025 donation and transplantation data.",
  "title": {
    "text": "Registering doubles the chance your family says yes",
    "subtitle": [
      "Out of every 10 families asked about organ donation in hospital"
    ],
    "anchor": "start",
    "font": "Inter, system-ui, sans-serif",
    "fontSize": 15,
    "fontWeight": 600,
    "color": "#1e2430",
    "subtitleFont": "Inter, system-ui, sans-serif",
    "subtitleFontSize": 12,
    "subtitleColor": "#5c6675",
    "offset": 12
  },
  "width": 300,
  "height": 150,
  "background": null,
  "data": {
    "url": "data/consent_registration.csv",
    "format": {
      "type": "csv",
      "parse": {
        "said_yes": "number",
        "out_of": "number",
        "order": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "sequence(0, datum.out_of)",
      "as": "idx"
    },
    {
      "flatten": [
        "idx"
      ]
    },
    {
      "calculate": "datum.idx < datum.said_yes ? 'Said yes' : 'Said no'",
      "as": "answer"
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, sans-serif",
    "axis": {
      "labelColor": "#5c6675",
      "titleColor": "#5c6675",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "domainColor": "#c9cfd8",
      "tickColor": "#c9cfd8",
      "gridColor": "#e6e2db",
      "gridDash": [
        3,
        3
      ]
    },
    "legend": {
      "labelColor": "#5c6675",
      "titleColor": "#5c6675",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500
    }
  },
  "layer": [
    {
      "mark": {
        "type": "point",
        "shape": "M-0.26,-0.74 a0.26,0.26 0 1,0 0.52,0 a0.26,0.26 0 1,0 -0.52,0 Z M-0.42,-0.36 L0.42,-0.36 L0.58,0.38 L0.34,0.38 L0.28,1 L-0.28,1 L-0.34,0.38 L-0.58,0.38 Z",
        "filled": true,
        "size": 700,
        "strokeWidth": 0
      },
      "encoding": {
        "x": {
          "field": "idx",
          "type": "ordinal",
          "axis": null
        },
        "y": {
          "field": "group",
          "type": "nominal",
          "sort": {
            "field": "order"
          },
          "axis": {
            "title": null,
            "domain": false,
            "ticks": false,
            "labelFontSize": 12,
            "labelFontWeight": 600,
            "labelColor": "#1e2430",
            "labelPadding": 10,
            "labelLimit": 180
          }
        },
        "color": {
          "field": "answer",
          "type": "nominal",
          "scale": {
            "domain": [
              "Said yes",
              "Said no"
            ],
            "range": [
              "#c8465e",
              "#d9d4cc"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom",
            "symbolType": "circle"
          }
        },
        "tooltip": [
          {
            "field": "group",
            "title": "Group"
          },
          {
            "field": "said_yes",
            "title": "Families who say yes (of 10)"
          }
        ]
      }
    }
  ]
}
