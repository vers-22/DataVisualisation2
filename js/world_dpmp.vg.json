{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "World choropleth of actual deceased organ donors per million population, 2024. Sources: IRODaT, Worldwide Actual Deceased Organ Donors Rate 2024; world-atlas (Natural Earth 1:110m) boundaries.",
  "title": {
    "text": "Australia ranks 21st of 83 countries",
    "subtitle": [
      "Actual deceased organ donors per million people, 2024. Grey = no data reported to IRODaT"
    ],
    "anchor": "start",
    "font": "Inter, system-ui, sans-serif",
    "fontSize": 15,
    "fontWeight": 600,
    "color": "#ffffff",
    "subtitleFont": "Inter, system-ui, sans-serif",
    "subtitleFontSize": 12,
    "subtitleColor": "#c3cad4",
    "offset": 12
  },
  "width": 1000,
  "height": 500,
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, sans-serif",
    "axis": {
      "labelColor": "#5c6675",
      "titleColor": "#5c6675",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "domainColor": "#c9cfd8",
      "tickColor": "#c9cfd8",
      "gridColor": "#e6e2db",
      "gridDash": [
        3,
        3
      ]
    },
    "legend": {
      "labelColor": "#c3cad4",
      "titleColor": "#c3cad4",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500
    }
  },
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#262e3c",
        "stroke": "#3a4456"
      }
    },
    {
      "data": {
        "url": "data/world_countries_110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/world_dpmp.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "iso_n3": "string",
                  "dpmp": "number"
                }
              }
            },
            "key": "iso_n3",
            "fields": [
              "country",
              "year",
              "dpmp",
              "note"
            ]
          }
        },
        {
          "calculate": "datum.properties.name",
          "as": "name"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#1e2430",
        "strokeWidth": 0.5,
        "invalid": null
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "!isValid(datum.dpmp)",
            "value": "#4a5263"
          },
          "field": "dpmp",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              55
            ],
            "range": [
              "#f6e3e2",
              "#e7a3a8",
              "#c8465e",
              "#7a1a2e"
            ]
          },
          "legend": {
            "title": "Donors per million",
            "orient": "bottom-left",
            "direction": "horizontal",
            "gradientLength": 200,
            "values": [
              0,
              10,
              20,
              30,
              40,
              50
            ]
          }
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Country"
          },
          {
            "field": "dpmp",
            "type": "quantitative",
            "title": "Donors per million (2024)",
            "format": ".2f"
          },
          {
            "field": "note",
            "title": "Note"
          }
        ],
        "stroke": {
          "condition": {
            "test": "datum.id === '036'",
            "value": "#ffffff"
          },
          "value": "#1e2430"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.id === '036'",
            "value": 1.5
          },
          "value": 0.5
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": -3.7,
            "lat": 40.4,
            "tx": -30.0,
            "ty": 30.0,
            "t": [
              "Spain 53.9",
              "world leader"
            ]
          },
          {
            "lon": -98.0,
            "lat": 39.0,
            "tx": -128.0,
            "ty": 12.0,
            "t": [
              "United States 49.7"
            ]
          },
          {
            "lon": 134.0,
            "lat": -25.0,
            "tx": 150.0,
            "ty": -48.0,
            "t": [
              "Australia 19.7"
            ]
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "color": "#c3cad4",
            "strokeWidth": 0.8
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "tx"
            },
            "latitude2": {
              "field": "ty"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 11,
            "fontWeight": 600,
            "color": "#ffffff",
            "lineHeight": 13,
            "baseline": "top",
            "dy": 3
          },
          "encoding": {
            "longitude": {
              "field": "tx",
              "type": "quantitative"
            },
            "latitude": {
              "field": "ty",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            }
          }
        }
      ]
    }
  ]
}
