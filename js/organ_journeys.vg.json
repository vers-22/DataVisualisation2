{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Linked hexagonal tile map and flow map of solid organs transplanted interstate in 2025. Clicking a state on the tile map filters the flow map to organs donated in that state. Source: ANZOD Registry Annual Report 2026, Appendix I, Table A1.25; ABS state boundaries.",
  "title": {
    "text": "Organs from small states travel",
    "subtitle": "Solid organs from deceased donors transplanted in another state, 2025",
    "anchor": "start",
    "font": "Inter, system-ui, sans-serif",
    "fontSize": 15,
    "fontWeight": 600,
    "color": "#1e2430",
    "subtitleFont": "Inter, system-ui, sans-serif",
    "subtitleFontSize": 12,
    "subtitleColor": "#5c6675",
    "offset": 14
  },
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, sans-serif",
    "axis": {
      "labelColor": "#5c6675",
      "titleColor": "#5c6675",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "domainColor": "#c9cfd8",
      "tickColor": "#c9cfd8",
      "gridColor": "#e6e2db",
      "gridDash": [
        3,
        3
      ]
    },
    "legend": {
      "labelColor": "#5c6675",
      "titleColor": "#5c6675",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500
    }
  },
  "spacing": 50,
  "hconcat": [
    {
      "data": {
        "values": [
          {
            "state": "NT",
            "q": 1,
            "r": 0
          },
          {
            "state": "QLD",
            "q": 2,
            "r": 0
          },
          {
            "state": "WA",
            "q": 0.5,
            "r": 1
          },
          {
            "state": "SA",
            "q": 1.5,
            "r": 1
          },
          {
            "state": "NSW",
            "q": 2.5,
            "r": 1
          },
          {
            "state": "VIC",
            "q": 2,
            "r": 2
          },
          {
            "state": "ACT",
            "q": 3,
            "r": 2
          },
          {
            "state": "TAS",
            "q": 1.5,
            "r": 3
          }
        ]
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/organs_leaving_state_2025.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "organs_transplanted": "number",
                  "transplanted_in_state": "number",
                  "sent_interstate": "number",
                  "pct_interstate": "number"
                }
              }
            },
            "key": "state",
            "fields": [
              "state_name",
              "organs_transplanted",
              "transplanted_in_state",
              "sent_interstate",
              "pct_interstate"
            ]
          }
        },
        {
          "calculate": "format(datum.pct_interstate, '.0f') + '%'",
          "as": "pct_label"
        }
      ],
      "encoding": {
        "x": {
          "field": "q",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -0.4,
              3.5
            ],
            "nice": false,
            "zero": false
          }
        },
        "y": {
          "field": "r",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              -0.65,
              5.083
            ],
            "nice": false,
            "zero": false,
            "reverse": true
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "point",
            "shape": "M0,-1 L0.866,-0.5 L0.866,0.5 L0,1 L-0.866,0.5 L-0.866,-0.5 Z",
            "filled": true,
            "size": 7600,
            "stroke": "#ffffff",
            "strokeWidth": 2,
            "opacity": 1,
            "cursor": "pointer"
          },
          "encoding": {
            "color": {
              "field": "pct_interstate",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  100
                ],
                "range": [
                  "#f6e3e2",
                  "#8e1f37"
                ]
              },
              "legend": {
                "title": "% sent interstate",
                "orient": "bottom",
                "direction": "horizontal",
                "gradientLength": 150,
                "values": [
                  0,
                  25,
                  50,
                  75,
                  100
                ]
              }
            },
            "tooltip": [
              {
                "field": "state_name",
                "title": "Donor state"
              },
              {
                "field": "organs_transplanted",
                "type": "quantitative",
                "title": "Organs transplanted"
              },
              {
                "field": "transplanted_in_state",
                "type": "quantitative",
                "title": "Transplanted in home state"
              },
              {
                "field": "sent_interstate",
                "type": "quantitative",
                "title": "Transplanted interstate"
              },
              {
                "field": "pct_interstate",
                "type": "quantitative",
                "title": "% interstate",
                "format": ".1f"
              }
            ],
            "opacity": {
              "condition": {
                "param": "pick",
                "empty": true,
                "value": 1
              },
              "value": 0.35
            },
            "stroke": {
              "condition": {
                "param": "pick",
                "empty": false,
                "value": "#1e2430"
              },
              "value": "#ffffff"
            },
            "strokeWidth": {
              "condition": {
                "param": "pick",
                "empty": false,
                "value": 2.5
              },
              "value": 2
            }
          },
          "params": [
            {
              "name": "pick",
              "select": {
                "type": "point",
                "fields": [
                  "state"
                ],
                "on": "click",
                "clear": "dblclick"
              }
            }
          ]
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 12,
            "fontWeight": 700,
            "dy": -7
          },
          "encoding": {
            "text": {
              "field": "state"
            },
            "color": {
              "condition": {
                "test": "datum.pct_interstate > 50",
                "value": "#ffffff"
              },
              "value": "#1e2430"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 10,
            "dy": 7
          },
          "encoding": {
            "text": {
              "field": "pct_label"
            },
            "color": {
              "condition": {
                "test": "datum.pct_interstate > 50",
                "value": "#ffffff"
              },
              "value": "#1e2430"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "q": 2.12,
                "r": 3.2,
                "t": [
                  "TAS, NT and ACT:",
                  "no transplants in 2025,",
                  "so every organ left"
                ]
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "fontSize": 10,
            "fontStyle": "italic",
            "color": "#1e2430",
            "lineHeight": 12
          },
          "encoding": {
            "x": {
              "field": "q",
              "type": "quantitative"
            },
            "y": {
              "field": "r",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            }
          }
        }
      ],
      "title": {
        "text": "Share of donated organs sent interstate",
        "subtitle": [
          "Click a state to show where its organs went"
        ],
        "anchor": "start",
        "font": "Inter, system-ui, sans-serif",
        "fontSize": 13,
        "fontWeight": 600,
        "color": "#1e2430",
        "subtitleFont": "Inter, system-ui, sans-serif",
        "subtitleFontSize": 11,
        "subtitleColor": "#5c6675",
        "offset": 10
      },
      "width": 330,
      "height": 420
    },
    {
      "title": {
        "text": "Where the organs went, 2025",
        "subtitle": [
          "Lines taper from the donor state (thick) to the transplanting state (thin)"
        ],
        "anchor": "start",
        "font": "Inter, system-ui, sans-serif",
        "fontSize": 13,
        "fontWeight": 600,
        "color": "#1e2430",
        "subtitleFont": "Inter, system-ui, sans-serif",
        "subtitleFontSize": 11,
        "subtitleColor": "#5c6675",
        "offset": 10
      },
      "width": 560,
      "height": 480,
      "projection": {
        "type": "conicEqualArea",
        "rotate": [
          -132,
          0
        ],
        "parallels": [
          -18,
          -36
        ],
        "center": [
          0,
          -27
        ]
      },
      "layer": [
        {
          "data": {
            "url": "data/au_states.topojson.json",
            "format": {
              "type": "topojson",
              "feature": "STE_2026_AUST_GDA2020"
            }
          },
          "transform": [
            {
              "filter": "datum.properties.STE_CODE26 <= '8'"
            }
          ],
          "mark": {
            "type": "geoshape",
            "fill": "#ece7df",
            "stroke": "#ffffff",
            "strokeWidth": 1
          }
        },
        {
          "data": {
            "url": "data/organ_flow_lines_2025.csv",
            "format": {
              "type": "csv",
              "parse": {
                "organs": "number",
                "end": "number",
                "lat": "number",
                "lon": "number"
              }
            }
          },
          "transform": [
            {
              "calculate": "datum.end === 0 ? datum.organs : 0",
              "as": "width"
            },
            {
              "calculate": "datum.origin",
              "as": "state"
            }
          ],
          "mark": {
            "type": "trail"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "detail": {
              "field": "flow_id",
              "type": "nominal"
            },
            "order": {
              "field": "end"
            },
            "size": {
              "field": "width",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  60
                ],
                "range": [
                  0,
                  16
                ]
              },
              "legend": null
            },
            "color": {
              "value": "#c8465e"
            },
            "opacity": {
              "condition": {
                "param": "pick",
                "empty": true,
                "value": 0.6
              },
              "value": 0.05
            },
            "tooltip": [
              {
                "field": "origin_city",
                "title": "From"
              },
              {
                "field": "destination_city",
                "title": "To"
              },
              {
                "field": "organs",
                "type": "quantitative",
                "title": "Organs (2025)"
              }
            ]
          }
        },
        {
          "data": {
            "url": "data/state_capitals.csv"
          },
          "mark": {
            "type": "circle",
            "size": 40,
            "color": "#1e2430"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "tooltip": [
              {
                "field": "city",
                "title": "City"
              }
            ]
          }
        },
        {
          "data": {
            "url": "data/state_capitals.csv"
          },
          "mark": {
            "type": "text",
            "fontSize": 11,
            "fontWeight": 600,
            "color": "#1e2430",
            "dy": -10
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "city"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "lon": 140.5,
                "lat": -42.2,
                "t": [
                  "52 of Tasmania's 73 organs",
                  "went to Victoria"
                ]
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "right",
            "fontSize": 10.5,
            "fontStyle": "italic",
            "color": "#1e2430",
            "lineHeight": 12
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "t"
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "organs": 10,
                "y": 0
              },
              {
                "organs": 25,
                "y": 1
              },
              {
                "organs": 50,
                "y": 2
              }
            ]
          },
          "transform": [
            {
              "calculate": "datum.organs * 16 / 60",
              "as": "w"
            },
            {
              "calculate": "380 + datum.y * 22",
              "as": "py"
            }
          ],
          "layer": [
            {
              "mark": {
                "type": "rule",
                "color": "#c8465e",
                "opacity": 0.6,
                "x": 12,
                "x2": 52
              },
              "encoding": {
                "y": {
                  "field": "py",
                  "type": "quantitative",
                  "scale": null
                },
                "strokeWidth": {
                  "field": "w",
                  "type": "quantitative",
                  "scale": null
                }
              }
            },
            {
              "mark": {
                "type": "text",
                "align": "left",
                "x": 60,
                "fontSize": 11,
                "color": "#5c6675"
              },
              "encoding": {
                "y": {
                  "field": "py",
                  "type": "quantitative",
                  "scale": null
                },
                "text": {
                  "field": "organs",
                  "type": "quantitative"
                }
              }
            }
          ]
        },
        {
          "data": {
            "values": [
              {
                "t": "Organs per year"
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "x": 12,
            "y": 360,
            "fontSize": 11,
            "fontWeight": 500,
            "color": "#5c6675"
          },
          "encoding": {
            "text": {
              "field": "t"
            }
          }
        }
      ]
    }
  ]
}
