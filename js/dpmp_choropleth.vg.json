{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth map of deceased organ donors per million population by state, 2025, coloured relative to the national target of 25. Sources: ANZOD Registry Annual Report 2026 Table 2.1; ABS ASGS Edition 3 state boundaries.",
  "title": {
    "text": "Only Tasmania beats the national target",
    "subtitle": [
      "Deceased organ donors per million people by state, 2025.",
      "Red = below the national average; blue = above"
    ],
    "anchor": "start"
  },
  "width": "container",
  "height": 520,
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, sans-serif",
    "title": {
      "anchor": "start",
      "font": "Inter, system-ui, sans-serif",
      "fontSize": 17,
      "fontWeight": 600,
      "color": "#1e2430",
      "subtitleFont": "Inter, system-ui, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#545e6c",
      "offset": 12,
      "subtitlePadding": 4
    },
    "axis": {
      "labelFont": "Inter, system-ui, sans-serif",
      "titleFont": "Inter, system-ui, sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 400,
      "labelColor": "#545e6c",
      "titleColor": "#545e6c",
      "domainColor": "#c9cfd8",
      "tickColor": "#c9cfd8",
      "gridColor": "#e6e2db",
      "gridDash": [
        3,
        3
      ]
    },
    "legend": {
      "labelFont": "Inter, system-ui, sans-serif",
      "titleFont": "Inter, system-ui, sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 400,
      "labelColor": "#545e6c",
      "titleColor": "#545e6c"
    },
    "text": {
      "font": "Inter, system-ui, sans-serif",
      "fontSize": 11
    }
  },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -132,
      0
    ],
    "parallels": [
      -18,
      -36
    ],
    "center": [
      0,
      -27
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/donors_by_state_year.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "donors": "number",
            "dpmp": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year === 2025 && datum.state !== 'AUS'"
        },
        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "data/au_states.topojson.json",
              "format": {
                "type": "topojson",
                "feature": "STE_2026_AUST_GDA2020"
              }
            },
            "key": "properties.STE_NAME26"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#b9b2a7",
        "strokeWidth": 0.8
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "dpmp",
          "type": "quantitative",
          "scale": {
            "domain": [
              15,
              45
            ],
            "domainMid": 20.2,
            "range": [
              "#8e1f37",
              "#ffffff",
              "#1f4e9e"
            ],
            "interpolate": "lab"
          },
          "legend": {
            "title": "Donors per million (white = national average)",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 240,
            "values": [
              20.2,
              30,
              40
            ],
            "labelExpr": "datum.value === 20.2 ? '20.2 avg' : datum.label",
            "titleLimit": 320
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State"
          },
          {
            "field": "donors",
            "type": "quantitative",
            "title": "Donors (2025)"
          },
          {
            "field": "dpmp",
            "type": "quantitative",
            "title": "Donors per million",
            "format": ".1f"
          }
        ]
      },
      "description": "State shapes. Data rows (2025 rates) are joined to ABS state boundaries with a lookup on the state name. Diverging scale centred on the national average (20.2, white): darker red = further below, darker blue = further above. Hue is fixed on each side; only lightness changes. Thin grey borders keep near-white states visible against the page."
    },
    {
      "data": {
        "url": "data/donors_by_state_year.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "donors": "number",
            "dpmp": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year === 2025 && datum.state !== 'AUS'"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "values": [
                {
                  "state": "WA",
                  "lon": 121.5,
                  "lat": -25.5
                },
                {
                  "state": "NT",
                  "lon": 133.4,
                  "lat": -19.8
                },
                {
                  "state": "SA",
                  "lon": 135.3,
                  "lat": -30.2
                },
                {
                  "state": "QLD",
                  "lon": 144.5,
                  "lat": -22.8
                },
                {
                  "state": "NSW",
                  "lon": 146.6,
                  "lat": -32.3
                },
                {
                  "state": "VIC",
                  "lon": 144.0,
                  "lat": -36.9
                },
                {
                  "state": "TAS",
                  "lon": 151.2,
                  "lat": -42.4
                },
                {
                  "state": "ACT",
                  "lon": 152.6,
                  "lat": -36.3
                }
              ]
            },
            "key": "state",
            "fields": [
              "lon",
              "lat"
            ]
          }
        },
        {
          "calculate": "datum.state + ' ' + format(datum.dpmp, '.1f')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 600,
        "font": "Inter, system-ui, sans-serif"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "color": {
          "value": "#1e2430"
        }
      },
      "description": "State abbreviation and rate at hand-picked label positions (ACT and TAS offshore)."
    },
    {
      "data": {
        "values": [
          {
            "lon": 140.2,
            "lat": -43.0,
            "t": [
              "Tasmania: 43.4 per million,",
              "the highest rate in the country"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#1f4e9e",
        "lineHeight": 13,
        "font": "Inter, system-ui, sans-serif"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      },
      "description": "Annotation pointing out Tasmania."
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "padding": 0
}
