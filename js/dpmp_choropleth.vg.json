{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth map of deceased organ donors per million population by state, 2025, coloured relative to the national target of 25. Sources: ANZOD Registry Annual Report 2026 Table 2.1; ABS ASGS Edition 3 state boundaries.",
  "title": {
    "text": "Only Tasmania beats the national target",
    "subtitle": [
      "Deceased organ donors per million people by state, 2025. Target: 25 per million"
    ],
    "anchor": "start",
    "font": "Inter, system-ui, sans-serif",
    "fontSize": 15,
    "fontWeight": 600,
    "color": "#1e2430",
    "subtitleFont": "Inter, system-ui, sans-serif",
    "subtitleFontSize": 12,
    "subtitleColor": "#5c6675",
    "offset": 12
  },
  "width": 620,
  "height": 500,
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, sans-serif",
    "axis": {
      "labelColor": "#5c6675",
      "titleColor": "#5c6675",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500,
      "domainColor": "#c9cfd8",
      "tickColor": "#c9cfd8",
      "gridColor": "#e6e2db",
      "gridDash": [
        3,
        3
      ]
    },
    "legend": {
      "labelColor": "#5c6675",
      "titleColor": "#5c6675",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titleFontWeight": 500
    }
  },
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -132,
      0
    ],
    "parallels": [
      -18,
      -36
    ],
    "center": [
      0,
      -27
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/donors_by_state_year.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "donors": "number",
            "dpmp": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year === 2025 && datum.state !== 'AUS'"
        },
        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "data/au_states.topojson.json",
              "format": {
                "type": "topojson",
                "feature": "STE_2026_AUST_GDA2020"
              }
            },
            "key": "properties.STE_NAME26"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "dpmp",
          "type": "quantitative",
          "scale": {
            "domain": [
              15,
              45
            ],
            "domainMid": 25,
            "range": [
              "#c8465e",
              "#f3e3df",
              "#2f6f73"
            ]
          },
          "legend": {
            "title": "Donors per million",
            "orient": "bottom-left",
            "direction": "horizontal",
            "gradientLength": 180,
            "values": [
              15,
              20,
              25,
              30,
              35,
              40,
              45
            ]
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State"
          },
          {
            "field": "donors",
            "type": "quantitative",
            "title": "Donors (2025)"
          },
          {
            "field": "dpmp",
            "type": "quantitative",
            "title": "Donors per million",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/donors_by_state_year.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "donors": "number",
            "dpmp": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year === 2025 && datum.state !== 'AUS'"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "values": [
                {
                  "state": "WA",
                  "lon": 121.5,
                  "lat": -25.5
                },
                {
                  "state": "NT",
                  "lon": 133.4,
                  "lat": -19.8
                },
                {
                  "state": "SA",
                  "lon": 135.3,
                  "lat": -30.2
                },
                {
                  "state": "QLD",
                  "lon": 144.5,
                  "lat": -22.8
                },
                {
                  "state": "NSW",
                  "lon": 146.6,
                  "lat": -32.3
                },
                {
                  "state": "VIC",
                  "lon": 144.0,
                  "lat": -36.9
                },
                {
                  "state": "TAS",
                  "lon": 151.2,
                  "lat": -42.4
                },
                {
                  "state": "ACT",
                  "lon": 152.6,
                  "lat": -36.3
                }
              ]
            },
            "key": "state",
            "fields": [
              "lon",
              "lat"
            ]
          }
        },
        {
          "calculate": "datum.state + ' ' + format(datum.dpmp, '.1f')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "color": {
          "condition": {
            "test": "datum.state === 'TAS' || datum.state === 'ACT'",
            "value": "#1e2430"
          },
          "value": "#ffffff"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 140.5,
            "lat": -43.9,
            "t": [
              "Tasmania: 43.4 per million,",
              "the highest rate in the country"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#2f6f73",
        "lineHeight": 13
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    }
  ]
}
